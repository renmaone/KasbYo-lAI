# Database (PostgreSQL 16)
DATABASE_URL="postgresql://kasbyol:kasbyol_secret@localhost:5432/kasbyol_db?schema=public"

# Redis (BullMQ & Rate Limiting)
REDIS_HOST="localhost"
REDIS_PORT=6379

# JWT Authentication
JWT_ACCESS_SECRET="change_me_super_secure_access_secret_min_32_chars"
JWT_REFRESH_SECRET="change_me_super_secure_refresh_secret_min_32_chars"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# MinIO / S3 Object Storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="kasbyol-files"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin123"

# SMTP / Email (Local Mailhog)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="no-reply@kasbyol.uz"

# AI Mentor (Anthropic Claude API - optional; if empty, module reports unconfigured)
ANTHROPIC_API_KEY=""
AI_DAILY_LIMIT=25

# Frontend URL & CORS
CORS_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
